class Solution:
    def find(self, arr, x):
        
        # code here
        
        n=len(arr)
        first=-1
        last=-1
        
        if x not in arr:
            return [-1,-1]
        for i in range(n):
            if arr[i]== x:
                first=i
                break
                
        for j in range(n-1,-1,-1):
            if arr[j]==x:
                last=j
                break
        return [first,last]
